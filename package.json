{
  "name": "droidgear",
  "private": true,
  "version": "1.3.6",
  "type": "module",
  "description": "BYOK Model Configuration for Factory Droid",
  "author": "Danny Smith",
  "copyright": "Copyright © 2025 Danny Smith. All rights reserved.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "rust:fmt": "cd src-tauri && cargo fmt",
    "rust:fmt:check": "cd src-tauri && cargo fmt --check",
    "rust:clippy": "cd src-tauri && cargo clippy -p droidgear-core -p droidgear-tui -- -D warnings",
    "rust:clippy:fix": "cd src-tauri && cargo clippy -p droidgear-core -p droidgear-tui --fix --allow-dirty",
    "rust:test": "cd src-tauri && cargo test -p droidgear-core -p droidgear-tui",
    "rust:bindings": "cd src-tauri && cargo run --bin export_bindings",
    "tauri": "tauri",
    "tauri:dev": "bash scripts/tauri-dev.sh",
    "tui": "cd src-tauri && cargo run -p droidgear-tui --",
    "tui:dev": "bash scripts/tui-dev.sh",
    "tui:build": "cd src-tauri && cargo build -p droidgear-tui --release",
    "tui:check": "cd src-tauri && cargo check -p droidgear-tui",
    "tauri:build": "npm run tauri build",
    "tauri:check": "npm run typecheck && npm run tauri -- build --no-bundle",
    "test:all": "npm run test:run && npm run rust:test",
    "check:all": "npm run typecheck && npm run biome:lint && npm run ast:lint && npm run format:check && npm run rust:fmt:check && npm run rust:clippy && npm run test:run && npm run rust:test",
    "fix:all": "npm run biome:fix && npm run format && npm run ast:fix && npm run rust:fmt && npm run rust:clippy:fix",
    "ts:version": "tsc --version",
    "build:analyze": "vite build && echo '\\n📊 Bundle analysis complete. Check dist/ folder sizes or use a tool like webpack-bundle-analyzer on the dist folder.'",
    "release:prepare": "node scripts/prepare-release.js",
    "task:complete": "node scripts/complete-task.js",
    "task:rename-done": "node scripts/complete-task.js --rename-existing",
    "knip": "knip",
    "jscpd": "jscpd",
    "models:sync-pi-thinking": "node scripts/sync-pi-thinking-level-maps.js",
    "ast:lint": "ast-grep scan",
    "ast:fix": "ast-grep scan --update-all",
    "biome:lint": "biome check --formatter-enabled=false",
    "biome:fix": "biome check --formatter-enabled=false --write",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@tauri-apps/api": "3.0.0-alpha.3",
    "@tauri-apps/plugin-clipboard-manager": "3.0.0-alpha.3",
    "@tauri-apps/plugin-dialog": "3.0.0-alpha.4",
    "@tauri-apps/plugin-fs": "3.0.0-alpha.3",
    "@tauri-apps/plugin-log": "3.0.0-alpha.3",
    "@tauri-apps/plugin-notification": "3.0.0-alpha.3",
    "@tauri-apps/plugin-opener": "3.0.0-alpha.3",
    "@tauri-apps/plugin-os": "3.0.0-alpha.3",
    "@tauri-apps/plugin-process": "3.0.0-alpha.3",
    "@tauri-apps/plugin-updater": "3.0.0-alpha.3",
    "@tauri-apps/plugin-window-state": "3.0.0-alpha.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.5.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-resizable-panels": "^4.14.8",
    "react-rnd": "^10.5.2",
    "shiki": "^4.5.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tauri-plugin-system-fonts-api": "^2.0.2",
    "tauri-pty": "0.3.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.51.0",
    "@biomejs/biome": "^2.6.2",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "3.0.0-alpha.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "lightningcss": "^1.31.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.7.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "^14.0.0",
    "@babel/plugin-proposal-private-methods": "npm:@babel/plugin-transform-private-methods@^7.25.0",
    "js-yaml": "^4.3.2",
    "smol-toml": "^1.7.1"
  },
  "allowScripts": {
    "@ast-grep/cli@0.51.0": true
  }
}
